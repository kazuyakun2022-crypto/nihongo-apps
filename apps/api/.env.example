# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Jika web diakses lewat ngrok, tambahkan origin ngrok
NGROK_WEB_ORIGIN=
PUBLIC_WEB_ORIGIN=

# Database (sesuai docker-compose.yml)
DATABASE_URL=postgresql://nihongo:nihongo@localhost:5432/nihongo?schema=public

# Auth - ganti dengan string acak panjang di production
JWT_ACCESS_SECRET=ganti-dengan-rahasia-access
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# AI maskot - kosongkan ANTHROPIC_API_KEY untuk memakai maskot tiruan (mock)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Suara Miu-chan lewat ElevenLabs (opsional). Isi API key + voice ID untuk mengaktifkan;
# kosong = Gemini TTS (GEMINI_API_KEY), lalu Edge TTS sebagai cadangan.
# Cari voice ID: npm run voice:elevenlabs   ·   coba suara: npm run voice:elevenlabs -- --try <voiceId>
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = cepat & hemat kredit; eleven_multilingual_v2 = kualitas lebih tinggi, lebih lambat & mahal
ELEVENLABS_MODEL=eleven_flash_v2_5
# Bagian bahasa Jepang lewat VOICEVOX (gratis, suara Jepang asli).
# Lokal: docker compose up -d voicevox. Pilih karakter: npm run voice:voicevox
VOICEVOX_URL=http://localhost:50021
# 8 = 春日部つむぎ (ノーマル)
VOICEVOX_SPEAKER=8
# Bagian bahasa Indonesia: gemini (bawaan) | elevenlabs | voicevox. Bila gagal/kuota habis → VOICEVOX (katakana).
VOICEVOX_INDONESIAN=gemini

# Google OAuth (dapatkan di Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kuota percakapan AI untuk Pelajar gratis
FREE_DAILY_AI_SESSIONS=5

# Akun pengelola yang dibuat `npm run db:seed`. Wajib diisi jika NODE_ENV=production
# (di development, kosong = superadmin@nihongo.local / SuperAdmin12345). Password minimal 12 karakter.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Opsional
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
