# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Jika web diakses lewat ngrok, tambahkan origin ngrok
NGROK_WEB_ORIGIN=
PUBLIC_WEB_ORIGIN=

# Database (sesuai docker-compose.yml)
DATABASE_URL=postgresql://nihongo:nihongo@localhost:5432/nihongo?schema=public

# Auth - ganti dengan string acak panjang di production
JWT_ACCESS_SECRET=ganti-dengan-rahasia-access
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# AI maskot - kosongkan ANTHROPIC_API_KEY untuk memakai maskot tiruan (mock)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Google OAuth (dapatkan di Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email production (https://resend.com). Kosong = link verifikasi/reset dicetak ke terminal API.
# EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend; onboarding@resend.dev hanya bisa mengirim ke email pemilik akun Resend.
RESEND_API_KEY=
EMAIL_FROM=Nihongo <onboarding@resend.dev>

# Kuota percakapan AI untuk Pelajar gratis
FREE_DAILY_AI_SESSIONS=5

# Web Push (VAPID). Buat pasangan kunci dengan: npx web-push generate-vapid-keys
# Private key hanya di server. Kosong = push dimatikan, notifikasi in-app tetap jalan.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nihongo.local
PUSH_TTL_SECONDS=86400

# Rahasia endpoint cron pengingat (/api/notifications/cron). Kosong = cron ditolak.
CRON_SECRET=

# Akun pengelola yang dibuat `npm run db:seed`. Wajib diisi jika NODE_ENV=production
# (di development, kosong = superadmin@nihongo.local / SuperAdmin12345). Password minimal 12 karakter.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Opsional
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
