// Skema database sesuai dokumen rancangan (bagian 9 dan 10.9).
// Nama tabel dan kolom di PostgreSQL memakai snake_case lewat @@map / @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enum ─────────────

enum Role {
  guest
  student
  premium
  teacher
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  pending_deletion
}

enum LearningGoal {
  jlpt
  kerja
  hobi
  wisata
}

enum OAuthProvider {
  google
  apple
}

enum Gender {
  male
  female
  other
}

enum SubscriptionPlan {
  monthly
  yearly
}

enum PaymentProvider {
  midtrans
  xendit
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum ContentStatus {
  draft
  review
  published
}

enum QuizType {
  pilihan_ganda
  susun_kalimat
  mendengar
  susun_huruf
  menulis
  berbicara
}

enum ChapterProgressStatus {
  locked
  open
  completed
}

enum SrsItemType {
  vocab
  kanji
}

enum ExamType {
  placement
  level_up
  jlpt_sim
}

enum ExamSection {
  kosakata
  tata_bahasa
  membaca
  mendengar
}

enum FuriganaRule {
  full
  hard_only
  none
}

enum ConversationMode {
  scenario
  free
}

enum InputMode {
  text
  voice
}

enum MessageSender {
  user
  mascot
}

enum MemoryType {
  interest
  mistake
  fact
}

// ───────────── Akun dan langganan ─────────────

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String?       @unique @db.VarChar(255)
  passwordHash        String?       @map("password_hash") @db.VarChar(255)
  isGuest             Boolean       @default(false) @map("is_guest")
  displayName         String        @map("display_name") @db.VarChar(50)
  role                Role          @default(student)
  status              UserStatus    @default(active)
  currentLevelId      Int?          @map("current_level_id") @db.SmallInt
  pendingLevelId      Int?          @map("pending_level_id") @db.SmallInt
  learningGoal        LearningGoal? @map("learning_goal")
  gender              Gender?       @map("gender")
  avatarUrl           String?       @map("avatar_url") @db.Text
  dailyTargetMin      Int?          @map("daily_target_min") @db.SmallInt
  xpTotal             Int           @default(0) @map("xp_total")
  streakCount         Int           @default(0) @map("streak_count")
  lastActiveDate      DateTime?     @map("last_active_date") @db.Date
  emailVerifiedAt     DateTime?     @map("email_verified_at") @db.Timestamptz
  failedLoginCount    Int           @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil         DateTime?     @map("locked_until") @db.Timestamptz
  lastLoginAt         DateTime?     @map("last_login_at") @db.Timestamptz
  totpSecret          String?       @map("totp_secret") @db.VarChar(64)
  deletionRequestedAt DateTime?     @map("deletion_requested_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  currentLevel        Level?               @relation(fields: [currentLevelId], references: [id])
  pendingLevel        Level?               @relation("PendingLevel", fields: [pendingLevelId], references: [id])
  oauthAccounts       OAuthAccount[]
  sessions            AuthSession[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  subscriptions       Subscription[]
  achievements        UserAchievement[]
  chapterProgress     UserChapterProgress[]
  srsCards            SrsCard[]
  examAttempts        ExamAttempt[]
  conversations       ConversationSession[]
  memories            UserMemory[]
  mascots             UserMascot[]
  chaptersCreated     Chapter[]            @relation("ChapterCreator")
  chaptersApproved    Chapter[]            @relation("ChapterApprover")
  scenariosCreated    Scenario[]
  promptsUpdated      AiLevelPrompt[]
  auditActions        AuditLog[]           @relation("AuditActor")
  auditTargets        AuditLog[]           @relation("AuditTarget")

  @@map("users")
}

model OAuthAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  email          String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?   @map("device_name") @db.VarChar(100)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String    @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  requestedIp String?   @map("requested_ip") @db.Inet
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  actorId      String   @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String   @db.VarChar(50)
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor        User     @relation("AuditActor", fields: [actorId], references: [id])
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@map("audit_logs")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  plan        SubscriptionPlan
  provider    PaymentProvider
  providerRef String?            @map("provider_ref") @db.VarChar(255)
  status      SubscriptionStatus
  startedAt   DateTime           @map("started_at") @db.Timestamptz
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Achievement {
  id          Int               @id @default(autoincrement())
  code        String            @unique @db.VarChar(50)
  name        String            @db.VarChar(100)
  description String?
  iconUrl     String?           @map("icon_url")
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String      @map("user_id") @db.Uuid
  achievementId Int         @map("achievement_id")
  earnedAt      DateTime    @default(now()) @map("earned_at") @db.Timestamptz
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
  @@map("user_achievements")
}

// ───────────── Materi ─────────────

model Level {
  id          Int      @id @db.SmallInt
  code        String   @unique @db.VarChar(10)
  name        String   @db.VarChar(50)
  sortOrder   Int      @map("sort_order") @db.SmallInt
  isPremium   Boolean  @default(false) @map("is_premium")

  users                User[]
  chapters             Chapter[]
  scenarios            Scenario[]
  prompt               AiLevelPrompt?
  examAttempts         ExamAttempt[]
  conversations        ConversationSession[]
  levelExams           LevelExam[]
  examQuestions        ExamQuestion[]
  examAttemptsResult   ExamAttempt[]        @relation("ResultLevel")
  usersPending         User[]               @relation("PendingLevel")

  @@map("levels")
}

model Chapter {
  id          String        @id @default(uuid()) @db.Uuid
  levelId     Int           @map("level_id") @db.SmallInt
  title       String        @db.VarChar(150)
  explanation String?
  sortOrder   Int           @map("sort_order") @db.SmallInt
  status      ContentStatus @default(draft)
  createdById String?       @map("created_by") @db.Uuid
  approvedById String?      @map("approved_by") @db.Uuid
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  // Penanda bab hasil impor dataset (mis. "jlpt:n5:makanan_minuman:1"); impor ulang tidak menimpa bab yang sudah ada
  sourceKey   String?       @unique @map("source_key") @db.VarChar(100)

  level         Level                 @relation(fields: [levelId], references: [id])
  createdBy     User?                 @relation("ChapterCreator", fields: [createdById], references: [id])
  approvedBy    User?                 @relation("ChapterApprover", fields: [approvedById], references: [id])
  vocabularies  Vocabulary[]
  kanji         Kanji[]
  grammarPoints GrammarPoint[]
  quizQuestions QuizQuestion[]
  progress      UserChapterProgress[]

  @@index([levelId, sortOrder])
  @@map("chapters")
}

model Vocabulary {
  id                 String  @id @default(uuid()) @db.Uuid
  chapterId          String  @map("chapter_id") @db.Uuid
  word               String  @db.VarChar(50)
  reading            String  @db.VarChar(50)
  meaningId          String  @map("meaning_id") @db.VarChar(255)
  exampleSentence    String? @map("example_sentence")
  exampleTranslation String? @map("example_translation")
  audioUrl           String? @map("audio_url")
  chapter            Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("vocabularies")
}

model Kanji {
  id             String  @id @default(uuid()) @db.Uuid
  chapterId      String  @map("chapter_id") @db.Uuid
  character      String  @db.VarChar(1)
  onyomi         String? @db.VarChar(50)
  kunyomi        String? @db.VarChar(50)
  meaningId      String  @map("meaning_id") @db.VarChar(255)
  strokeOrderUrl String? @map("stroke_order_url")
  chapter        Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("kanji")
}

model GrammarPoint {
  id              String  @id @default(uuid()) @db.Uuid
  chapterId       String  @map("chapter_id") @db.Uuid
  pattern         String  @db.VarChar(100)
  explanation     String
  exampleSentence String? @map("example_sentence")
  exampleTranslation String? @map("example_translation")
  chapter         Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("grammar_points")
}

model QuizQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  chapterId     String   @map("chapter_id") @db.Uuid
  type          QuizType
  question      String
  options       Json?
  correctAnswer String   @map("correct_answer")
  audioUrl      String?  @map("audio_url")
  // Petunjuk yang tampil saat mengerjakan (mis. arti kata); explanation baru tampil setelah dinilai
  hint          String?  @db.VarChar(255)
  explanation   String?
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model Scenario {
  id          String        @id @default(uuid()) @db.Uuid
  levelId     Int           @map("level_id") @db.SmallInt
  title       String        @db.VarChar(150)
  goal        String
  mascotRole  String        @map("mascot_role")
  targetVocab Json?         @map("target_vocab")
  maxTurns    Int           @default(20) @map("max_turns") @db.SmallInt
  status      ContentStatus @default(draft)
  createdById String?       @map("created_by") @db.Uuid

  level         Level                 @relation(fields: [levelId], references: [id])
  createdBy     User?                 @relation(fields: [createdById], references: [id])
  conversations ConversationSession[]

  @@map("scenarios")
}

// ───────────── Progres belajar ─────────────

model UserChapterProgress {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  chapterId   String                @map("chapter_id") @db.Uuid
  status      ChapterProgressStatus @default(open)
  bestScore   Int?                  @map("best_score") @db.SmallInt
  completedAt DateTime?             @map("completed_at") @db.Timestamptz
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter     Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("user_chapter_progress")
}

model SrsCard {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  itemType     SrsItemType @map("item_type")
  itemId       String      @map("item_id") @db.Uuid
  easeFactor   Decimal     @default(2.5) @map("ease_factor") @db.Decimal(3, 2)
  intervalDays Int         @default(0) @map("interval_days")
  repetitions  Int         @default(0)
  lapseCount   Int         @default(0) @map("lapse_count")
  dueDate      DateTime    @map("due_date") @db.Date
  isWeak       Boolean     @default(false) @map("is_weak")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, dueDate])
  @@map("srs_cards")
}

model ExamAttempt {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  levelId       Int       @map("level_id") @db.SmallInt
  type          ExamType
  score         Int       @db.SmallInt
  passed        Boolean
  details       Json?
  sectionScores Json?     @map("section_scores")
  examId        String?   @map("exam_id")
  resultLevelId Int?      @map("result_level_id") @db.SmallInt
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  takenAt       DateTime  @default(now()) @map("taken_at") @db.Timestamptz
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         Level     @relation(fields: [levelId], references: [id])
  exam          LevelExam? @relation(fields: [examId], references: [id])
  resultLevel   Level?    @relation("ResultLevel", fields: [resultLevelId], references: [id])
  answers       ExamAttemptAnswer[]

  @@map("exam_attempts")
}

model LevelExam {
  id                   String   @id @default(uuid())
  levelId              Int      @map("level_id") @db.SmallInt
  type                 ExamType
  questionCount        Int      @default(20) @map("question_count") @db.SmallInt
  timeLimitMin         Int      @default(15) @map("time_limit_min") @db.SmallInt
  passScore            Int      @default(70) @map("pass_score") @db.SmallInt
  sectionMinScore      Int      @default(50) @map("section_min_score") @db.SmallInt
  cooldownHours        Int      @default(0) @map("cooldown_hours") @db.SmallInt
  minChapterCompletion Int      @default(0) @map("min_chapter_completion") @db.SmallInt
  level                Level    @relation(fields: [levelId], references: [id])
  attempts             ExamAttempt[]

  @@unique([levelId, type])
  @@map("level_exams")
}

model ExamQuestion {
  id            String      @id @default(uuid())
  levelId       Int         @map("level_id") @db.SmallInt
  section       ExamSection
  type          String      @default("pilihan_ganda")
  question      String
  hint          String?     @db.VarChar(255)
  options       Json
  correctAnswer String      @map("correct_answer")
  audioUrl      String?     @map("audio_url")
  difficulty    Int         @default(1) @db.SmallInt
  status        String      @default("published")
  explanation   String?
  sourceKey     String?     @unique @map("source_key") @db.VarChar(100)
  level         Level       @relation(fields: [levelId], references: [id])
  answers       ExamAttemptAnswer[]

  @@map("exam_questions")
}

model ExamAttemptAnswer {
  id         String        @id @default(uuid()) @db.Uuid
  attemptId  String        @map("attempt_id") @db.Uuid
  questionId String        @map("question_id")
  answer     String
  isCorrect  Boolean       @map("is_correct")
  attempt    ExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   ExamQuestion? @relation(fields: [questionId], references: [id])

  @@map("exam_attempt_answers")
}

// ───────────── AI maskot ─────────────

model Mascot {
  id            Int                   @id @default(autoincrement())
  name          String                @db.VarChar(50)
  personality   String
  avatarUrl     String?               @map("avatar_url")
  voiceId       String?               @map("voice_id") @db.VarChar(100)
  conversations ConversationSession[]
  users         UserMascot[]

  @@map("mascots")
}

model AiLevelPrompt {
  id               Int          @id @default(autoincrement())
  levelId          Int          @unique @map("level_id") @db.SmallInt
  systemPrompt     String       @map("system_prompt")
  maxSentenceWords Int          @map("max_sentence_words") @db.SmallInt
  furiganaRule     FuriganaRule @map("furigana_rule")
  speechRate       Decimal      @default(1.0) @map("speech_rate") @db.Decimal(3, 2)
  updatedById      String?      @map("updated_by") @db.Uuid
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  level            Level        @relation(fields: [levelId], references: [id])
  updatedBy        User?        @relation(fields: [updatedById], references: [id])

  @@map("ai_level_prompts")
}

model ConversationSession {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  mascotId           Int              @map("mascot_id")
  scenarioId         String?          @map("scenario_id") @db.Uuid
  levelId            Int              @map("level_id") @db.SmallInt
  mode               ConversationMode
  inputMode          InputMode        @default(text) @map("input_mode")
  turnCount          Int              @default(0) @map("turn_count") @db.SmallInt
  pronunciationScore Int?             @map("pronunciation_score") @db.SmallInt
  summary            String?
  startedAt          DateTime         @default(now()) @map("started_at") @db.Timestamptz
  endedAt            DateTime?        @map("ended_at") @db.Timestamptz

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mascot   Mascot                @relation(fields: [mascotId], references: [id])
  scenario Scenario?             @relation(fields: [scenarioId], references: [id])
  level    Level                 @relation(fields: [levelId], references: [id])
  messages ConversationMessage[]

  @@index([userId, startedAt])
  @@map("conversation_sessions")
}

model ConversationMessage {
  id           String              @id @default(uuid()) @db.Uuid
  sessionId    String              @map("session_id") @db.Uuid
  sender       MessageSender
  text         String
  furiganaHtml String?             @map("furigana_html")
  audioUrl     String?             @map("audio_url")
  correction   Json?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  session      ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("conversation_messages")
}

model UserMemory {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  type      MemoryType
  content   String
  weight    Int        @default(1) @db.SmallInt
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_memory")
}

model UserMascot {
  userId         String @map("user_id") @db.Uuid
  mascotId       Int    @map("mascot_id")
  affinityPoints Int    @default(0) @map("affinity_points")
  unlockedItems  Json?  @map("unlocked_items")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mascot         Mascot @relation(fields: [mascotId], references: [id])

  @@id([userId, mascotId])
  @@map("user_mascots")
}
