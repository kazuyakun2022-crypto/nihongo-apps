@@ -0,0 +1,101 @@
+/**
+ * Mengukur volume mikrofon dan suara Neko (0..1) untuk animasi.
+ *
+ * - Panggil resume() di dalam aksi pengguna (misalnya saat tombol mic ditekan),
+ *   karena browser menahan AudioContext sampai ada interaksi.
+ * - attachVoice() hanya menyambungkan audio kalau AudioContext sudah berjalan.
+ *   Kalau tidak, audio diputar seperti biasa dan animasi memakai gerak bibir tiruan.
+ */
+export class AudioMeter {
+  private ctx: AudioContext | null = null;
+  private mic: { source: MediaStreamAudioSourceNode; analyser: AnalyserNode; stream: MediaStream } | null = null;
+  private voice: { source: MediaElementAudioSourceNode; analyser: AnalyserNode } | null = null;
+  private buf = new Float32Array(1024);
+  private peak = { mic: 0.08, voice: 0.08 };
+
+  resume(): void {
+    if (typeof window === "undefined") return;
+    try {
+      if (!this.ctx) {
+        const Ctor =
+          window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
+        if (!Ctor) return;
+        this.ctx = new Ctor();
+      }
+      if (this.ctx.state === "suspended") void this.ctx.resume();
+    } catch {
+      this.ctx = null;
+    }
+  }
+
+  attachMic(stream: MediaStream): void {
+    if (!this.ctx || this.mic?.stream === stream) return;
+    try {
+      this.mic?.source.disconnect();
+      const source = this.ctx.createMediaStreamSource(stream);
+      const analyser = this.makeAnalyser();
+      source.connect(analyser);
+      this.mic = { source, analyser, stream };
+    } catch {
+      this.mic = null;
+    }
+  }
+
+  /** Mengembalikan true kalau suara bisa dianalisis. */
+  attachVoice(audio: HTMLAudioElement): boolean {
+    this.detachVoice();
+    if (!this.ctx || this.ctx.state !== "running") return false;
+    try {
+      const source = this.ctx.createMediaElementSource(audio);
+      const analyser = this.makeAnalyser();
+      source.connect(analyser);
+      analyser.connect(this.ctx.destination);
+      this.voice = { source, analyser };
+      return true;
+    } catch {
+      this.voice = null;
+      return false;
+    }
+  }
+
+  detachVoice(): void {
+    if (!this.voice) return;
+    try {
+      this.voice.source.disconnect();
+      this.voice.analyser.disconnect();
+    } catch {
+      /* sudah terputus */
+    }
+    this.voice = null;
+  }
+
+  micLevel = (): number => this.read(this.mic?.analyser, "mic");
+  voiceLevel = (): number => this.read(this.voice?.analyser, "voice");
+
+  dispose(): void {
+    this.detachVoice();
+    this.mic?.source.disconnect();
+    this.mic = null;
+    void this.ctx?.close().catch(() => undefined);
+    this.ctx = null;
+  }
+
+  private makeAnalyser(): AnalyserNode {
+    const a = this.ctx!.createAnalyser();
+    a.fftSize = 1024;
+    a.smoothingTimeConstant = 0.3;
+    return a;
+  }
+
+  private read(analyser: AnalyserNode | undefined, key: "mic" | "voice"): number {
+    if (!analyser) return 0;
+    analyser.getFloatTimeDomainData(this.buf);
+    let sum = 0;
+    for (let i = 0; i < this.buf.length; i++) sum += this.buf[i] * this.buf[i];
+    const rms = Math.sqrt(sum / this.buf.length);
+    // Penguatan otomatis: suara pelan atau keras sama-sama terlihat jelas
+    this.peak[key] = Math.max(rms, this.peak[key] * 0.995, 0.04);
+    const level = (rms - 0.008) / (this.peak[key] * 0.85);
+    return level < 0 ? 0 : level > 1 ? 1 : level;
+  }
+}
diff --git a/apps/web/src/shared/ui/neko/NekoAvatar.tsx b/apps/web/src/shared/ui/neko/NekoAvatar.tsx
new file mode 100644
index 0000000..089239e
--- /dev/null
+++ b/apps/web/src/shared/ui/neko/NekoAvatar.tsx
@@ -0,0 +1,169 @@
+"use client";
+
+import { useEffect, useRef, useState, type CSSProperties } from "react";
+import { NekoEngine, type LevelSource } from "./NekoEngine";
+import { ASSET_BASE, FX_SPOTS, POSES, rigToPercent, type NekoEmotion, type NekoMode } from "./nekoRig";
+import styles from "./nekoAvatar.module.css";
+
+export type { NekoEmotion, NekoMode } from "./nekoRig";
+export type { LevelSource } from "./NekoEngine";
+
+export interface NekoAvatarProps {
+  /** Status percakapan: idle, listening (mendengar), processing (berpikir), speaking (menjawab). */
+  mode?: NekoMode;
+  /** Emosi saat menjawab. Tetap terlihat sebentar setelah selesai bicara, lalu kembali biasa. */
+  emotion?: NekoEmotion;
+  /** Volume mikrofon 0..1, dibaca setiap frame saat mendengar. */
+  micLevel?: LevelSource;
+  /** Volume suara 0..1, dibaca setiap frame untuk gerak bibir. */
+  voiceLevel?: LevelSource;
+  /** Lebar avatar (angka = piksel). Default 100% dari wadah. */
+  size?: number | string;
+  className?: string;
+  label?: string;
+  onTap?: () => void;
+  /** Ubah nama file aset menjadi URL. Default: /neko/<file>. */
+  resolveAsset?: (file: string) => string;
+}
+
+/** Gambar statis untuk tiap emosi (dipakai saat WebGL tidak tersedia). */
+export function stillFor(emotion: NekoEmotion): string {
+  return POSES[emotion === "biasa" ? "idle" : emotion].still;
+}
+
+function box(x: number, y: number, w: number, h: number): CSSProperties {
+  const left = rigToPercent(x);
+  const top = rigToPercent(y);
+  return {
+    left: `${left}%`,
+    top: `${top}%`,
+    width: `${rigToPercent(x + w) - left}%`,
+    height: `${rigToPercent(y + h) - top}%`,
+  };
+}
+
+const bubble = (k: "pikirTanya" | "pikirLampu" | "pikirSeru" | "pikirTitik") =>
+  box(FX_SPOTS[k].x, FX_SPOTS[k].y, FX_SPOTS[k].w, FX_SPOTS[k].h);
+
+const POS = {
+  titik: bubble("pikirTitik"),
+  tanya: bubble("pikirTanya"),
+  seru: bubble("pikirSeru"),
+  lampu: bubble("pikirLampu"),
+  wavesL: box(FX_SPOTS.wavesL.x, FX_SPOTS.wavesL.y, FX_SPOTS.wavesL.w, FX_SPOTS.wavesL.h),
+  wavesR: box(FX_SPOTS.wavesR.x, FX_SPOTS.wavesR.y, FX_SPOTS.wavesR.w, FX_SPOTS.wavesR.h),
+};
+
+/**
+ * Maskot Miu-chan animasi penuh: bernapas, berkedip, mengikuti kursor,
+ * mendengar, berpikir, berbicara dengan gerak bibir, dan berganti ekspresi
+ * sesuai emosi jawaban. Efek seperti air mata, uap, dan tanda marah sudah
+ * ada di gambar tiap ekspresi. Tanpa WebGL tampil gambar statis.
+ */
+export function NekoAvatar({
+  mode = "idle",
+  emotion = "biasa",
+  micLevel,
+  voiceLevel,
+  size,
+  className,
+  label = "Miu-chan",
+  onTap,
+  resolveAsset,
+}: NekoAvatarProps) {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const fxRef = useRef<HTMLDivElement>(null);
+  const engineRef = useRef<NekoEngine | null>(null);
+  const [failed, setFailed] = useState(false);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    const root = rootRef.current;
+    if (!canvas || !root) return;
+    const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
+    const engine = new NekoEngine(canvas, root, fxRef.current, {
+      reducedMotion: reduced,
+      resolveAsset,
+      onError: (err) => {
+        console.warn("NekoAvatar: memakai gambar statis.", err);
+        setFailed(true);
+      },
+    });
+    engineRef.current = engine;
+    return () => {
+      engine.destroy();
+      engineRef.current = null;
+    };
+    // Engine dibuat sekali; resolveAsset hanya dibaca saat mulai
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useEffect(() => {
+    engineRef.current?.setMode(mode);
+  }, [mode]);
+
+  useEffect(() => {
+    engineRef.current?.setEmotion(emotion);
+  }, [emotion]);
+
+  useEffect(() => {
+    engineRef.current?.setLevelSources(micLevel ?? null, voiceLevel ?? null);
+  }, [micLevel, voiceLevel]);
+
+  const asset = (file: string) => (resolveAsset ? resolveAsset(file) : ASSET_BASE + file);
+  const style: CSSProperties | undefined =
+    size === undefined ? undefined : { width: typeof size === "number" ? `${size}px` : size };
+
+  return (
+    <div
+      ref={rootRef}
+      className={[styles.root, className].filter(Boolean).join(" ")}
+      style={style}
+      role="img"
+      aria-label={label}
+      data-mode={mode}
+      data-expr="biasa"
+      data-phase="main"
+    >
+      {failed ? (
+        // eslint-disable-next-line @next/next/no-img-element
+        <img className={styles.fallback} src={asset(stillFor(emotion))} alt="" draggable={false} />
+      ) : (
+        <canvas
+          ref={canvasRef}
+          className={styles.canvas}
