+    // Emosi yang sedang tampil
+    const want = this.desiredEmotion();
+    if (want !== this.shownEmotion) {
+      const from = this.shownEmotion;
+      this.shownEmotion = want;
+      this.emotionSince = t;
+      const x = EXPRESSION[want];
+      if (x.snap) {
+        this.shake = Math.max(this.shake, x.shake);
