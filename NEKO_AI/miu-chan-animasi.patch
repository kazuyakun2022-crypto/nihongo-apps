+      this.lookT.x = rand(-roam, roam);
+      this.lookT.y = rand(-roam * 0.5, roam * 0.4);
+      this.wanderAt = t + rand(1.8, 3.8);
+    }
+    let shiftX = 0;
+    let shiftY = 0;
+    let lean = 0;
+    let tilt = 0;
+    let headDown = 0;
+    let earBase = 0; // + = telinga tegak ke dalam, - = terkulai ke luar
