     if (q.includes("kanji")) return EXAMPLES.kanji;
@@ -29,3 +30,22 @@ export class MockAskProvider implements AskProvider {
     return `(Mode demo — belum ada API key)\n\nPertanyaanmu: "${question}"\n\nSaya bisa menjawab pertanyaan tentang:\n• Huruf hiragana, katakana, kanji\n• Partikel dan grammar\n• Kosakata sehari-hari\n• Salam dan ungkapan umum\n• Cara baca / pengucapan\n\nCoba tanyakan salah satunya! Untuk jawaban AI sungguhan, isi ANTHROPIC_API_KEY di .env.`;
   }
 }
+
+/** Jawaban suara tiruan dengan tanda emosi, supaya animasi Neko bisa dicoba tanpa API key. */
+function mockVoiceAnswer(q: string): string {
+  if (/(lulus|berhasil|menang)/.test(q)) return "[semangat] Waaah, selamat! Keren banget, ayo lanjut!";
+  if (/(tebak|bercanda)/.test(q)) return "[rese] Hehe, coba tebak sendiri dong~";
+  if (/(lucu|imut|cantik|manis)/.test(q)) return "[malu] E-eh? Apaan sih tiba-tiba... makasih deh.";
+  if (/(hah|serius|beneran)/.test(q)) return "[kaget] Hah? Beneran?! Aku kaget banget dengarnya!";
+  if (/(nangis|menangis)/.test(q)) return "[nangis] Huaaa... aku jadi ikut sedih banget. Sini aku temani.";
+  if (/(jelek|gendut|bodoh|pendek)/.test(q)) {
+    return "[marah] Enak aja ngomong begitu! Huh... ya udah, kali ini aku maafin deh.";
+  }
+  if (/(mandi|tidur siang|penyedot|nyebelin)/.test(q)) {
+    return "[kesal] Hmph, terserah deh... tapi aku tetap mau bantu kok.";
+  }
+  if (/(sedih|gagal|capek|kangen|sakit|kecewa|nangis)/.test(q)) {
+    return "[sedih] Yaah, aku ikut sedih dengarnya. Sini cerita pelan-pelan, aku dengerin kok.";
+  }
+  return "[biasa] Hehe, Miu-chan dengar kok! Ini mode demo, jadi jawabanku masih tiruan ya.";
+}
