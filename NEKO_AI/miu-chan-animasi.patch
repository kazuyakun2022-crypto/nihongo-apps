@@ -0,0 +1,127 @@
+/*
+ * Lapisan efek di atas kanvas maskot. Engine menulis data-mode, data-expr,
+ * data-phase, --neko-mic dan --neko-voice di elemen .root. Efek ekspresi
+ * (air mata, uap, tanda marah) sudah ada di gambar, jadi di sini hanya
+ * gelombang suara saat mendengar.
+ */
+
+.root {
+  --neko-wave: var(--color-primary, #b12a3a);
+  --neko-mic: 0;
+  --neko-voice: 0;
+  position: relative;
+  width: 100%;
+  aspect-ratio: 1 / 1;
+  user-select: none;
+  -webkit-user-select: none;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.canvas,
+.fallback {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  display: block;
+  cursor: pointer;
+}
+
+.fallback {
+  /* Gambar statis tidak punya padding seperti kanvas */
+  inset: 5.2%;
+  width: 89.6%;
+  height: 89.6%;
+  object-fit: contain;
+  cursor: default;
+}
+
+.fx {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  transform-origin: 50% 89.2%;
+}
+
+.fx > * {
+  position: absolute;
+  opacity: 0;
+  transition: opacity 0.35s ease;
+}
+
+/* ── Mendengar: gelombang suara mengikuti volume mikrofon ── */
+
+.waves i {
+  position: absolute;
+  top: 50%;
+  aspect-ratio: 1 / 2;
+  border: 0.35rem solid transparent;
+  border-radius: 50%;
+  transform: translateY(-50%);
+  animation: wavePulse 1.2s ease-out infinite;
+}
+
+.waves i:nth-child(1) { height: 40%; animation-delay: 0s; }
+.waves i:nth-child(2) { height: 68%; animation-delay: 0.15s; }
+.waves i:nth-child(3) { height: 96%; animation-delay: 0.3s; }
+
+.wavesL i { right: 0; border-left-color: var(--neko-wave); }
+.wavesL i:nth-child(2) { right: 18%; }
+.wavesL i:nth-child(3) { right: 36%; }
+.wavesR i { left: 0; border-right-color: var(--neko-wave); }
+.wavesR i:nth-child(2) { left: 18%; }
+.wavesR i:nth-child(3) { left: 36%; }
+
+.root[data-mode="listening"] .waves {
+  opacity: calc(0.35 + var(--neko-mic) * 0.65);
+  transform: scale(calc(0.85 + var(--neko-mic) * 0.35));
+  transition: opacity 0.2s ease;
+}
+
+@keyframes wavePulse {
+  0% { opacity: 0.25; }
+  40% { opacity: 1; }
+  100% { opacity: 0.25; }
+}
+
+/* ── Berpikir: gelembung pikiran muncul bergantian lalu melayang ── */
+
+.pikir {
+  object-fit: contain;
+  transform-origin: 50% 100%;
+}
+
+.root[data-mode="processing"] .pikir {
+  opacity: 1;
+  transition: none;
+  animation: pikirPop 0.45s cubic-bezier(0.34, 1.7, 0.64, 1) both, pikirFloat 2.4s ease-in-out 0.45s infinite;
+}
+
+.root[data-mode="processing"] .pikir1 { animation-delay: 0s, 0.45s; }
+.root[data-mode="processing"] .pikir2 { animation-delay: 0.5s, 0.95s; }
+.root[data-mode="processing"] .pikir3 { animation-delay: 1.1s, 1.55s; }
+.root[data-mode="processing"] .pikir4 { animation-delay: 1.8s, 2.25s; }
+
+@keyframes pikirPop {
+  from { opacity: 0; transform: scale(0) translateY(20%); }
+  to { opacity: 1; transform: scale(1); }
+}
+
+@keyframes pikirFloat {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(-6%); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .root[data-mode="processing"] .pikir {
+    opacity: 1;
+  }
+  .fx > *,
+  .fx i {
+    animation: none !important;
+  }
+  .root[data-mode="listening"] .waves {
+    transform: none;
+  }
+}
