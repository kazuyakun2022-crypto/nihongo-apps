+  const L2 = ax * ax + ay * ay;
+  const px = x - ear.base[0];
+  const py = y - ear.base[1];
+  const s = (px * ax + py * ay) / L2;
+  const d = Math.abs(px * ay - py * ax) / Math.sqrt(L2);
