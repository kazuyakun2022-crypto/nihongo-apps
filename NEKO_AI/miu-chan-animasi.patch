+      open: "senang",
+      anchor: [506, 748],
+      srcAnchor: [501, 719],
+      scaleX: 0.8,
+      maxOpen: 0.9,
+      minOpen: 0.3,
+    },
+  },
+  senang: {
+    id: "senang",
+    file: "base-senang.webp",
+    still: "maskot-senang.webp",
+    eyes: { mask: "eyes-senang.png", lid: "lids-senang.webp", spanL: [239, 427], spanR: [571, 775] },
+    lidTop: [0.994, 0.928, 0.847],
+    lidBottom: [0.996, 0.926, 0.851],
+    mouth: {
+      closed: "idle",
+      open: "senang",
+      anchor: [501, 719],
+      srcAnchor: [501, 719],
+      scaleX: 1,
+      maxOpen: 1,
+      minOpen: 0.3,
+    },
+  },
+  semangat: {
+    id: "semangat",
+    file: "base-semangat.webp",
+    still: "maskot-semangat.webp",
+    eyes: { mask: "eyes-semangat.png", lid: "lids-semangat.webp", spanL: [239, 427], spanR: [571, 775] },
+    lidTop: [0.996, 0.930, 0.855],
+    lidBottom: [0.994, 0.925, 0.853],
+    mouth: {
+      closed: "idle",
+      open: "senang",
+      anchor: [501, 719],
+      srcAnchor: [501, 719],
+      scaleX: 1,
+      maxOpen: 1,
+      minOpen: 0.3,
+    },
+  },
+  sedih: {
+    id: "sedih",
+    file: "base-sedih.webp",
+    still: "maskot-sedih.webp",
+    eyes: { mask: "eyes-sedih.png", lid: "lids-sedih.webp", spanL: [240, 422], spanR: [574, 773] },
+    lidTop: [0.887, 0.737, 0.691],
+    lidBottom: [0.987, 0.883, 0.828],
+    mouth: {
+      closed: "sedih",
+      open: "nangis",
+      anchor: [503, 742],
+      srcAnchor: [504, 735],
+      scaleX: 0.75,
+      maxOpen: 0.8,
+      minOpen: 0.35,
+    },
+  },
+  nangis: {
+    id: "nangis",
+    file: "base-nangis.webp",
+    still: "maskot-nangis.webp",
+    eyes: { mask: "eyes-nangis.png", lid: "lids-nangis.webp", spanL: [240, 421], spanR: [576, 774] },
+    lidTop: [0.964, 0.741, 0.692],
+    lidBottom: [0.936, 0.693, 0.648],
+    mouth: {
+      closed: "sedih",
+      open: "nangis",
+      anchor: [504, 735],
+      srcAnchor: [504, 735],
+      scaleX: 1,
+      maxOpen: 1,
+      minOpen: 0.35,
+    },
+  },
+  kesal: {
+    id: "kesal",
+    file: "base-kesal.webp",
